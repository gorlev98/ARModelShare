rules_version = '2';

// Firestore Security Rules for AR Model Sharing Application
// Deploy these rules to your Firebase project

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Models Collection - Users can only manage their own models
    match /models/{modelId} {
      // Allow read if user owns the model
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      
      // Allow create if user is authenticated and setting their own userId
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      
      // Allow update/delete if user owns the model
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }
    
    // Shared Links Collection
    match /shared_links/{linkId} {
      // Allow read if:
      // 1. User owns the link, OR
      // 2. Link is active and not expired (public access for AR viewing)
      allow read: if isAuthenticated() && isOwner(resource.data.userId)
                  || (resource.data.isActive == true && resource.data.expiresAt > request.time.toMillis());
      
      // Allow create if user is authenticated and setting their own userId
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      
      // Allow update/delete if user owns the link
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }
    
    // Activity Collection - Users can only manage their own activity
    match /activity/{activityId} {
      // Allow read if user owns the activity
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      
      // Allow create if user is authenticated and setting their own userId
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      
      // Users typically don't update or delete activity logs
      allow update, delete: if false;
    }
  }
}

// Storage Security Rules for AR Model Sharing Application
// Configure these in Firebase Storage rules

service firebase.storage {
  match /b/{bucket}/o {
    // Models are stored under models/{userId}/{filename}
    match /models/{userId}/{filename} {
      // Allow read if authenticated
      // Models need to be publicly readable for AR viewing via shared links
      allow read: if true;
      
      // Allow write only if user is authenticated and uploading to their own folder
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Allow delete only if user owns the file
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
